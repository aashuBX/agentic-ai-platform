# Copy to `.env` and fill in only what you actually want to enable.
# Nothing in this file is required — every default below runs the whole app, the LangGraph
# workflow, and the test suite with zero external services and zero API keys.
#
# Nested settings use a double underscore: LLM__PROVIDER -> settings.llm.provider.
# See README.md "Configuration" for which flags are required / optional / mock-by-default.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# LLM (multi-provider abstraction) — REQUIRED category, MOCK by default.
# provider=mock needs nothing below and is fully deterministic/offline.
# ---------------------------------------------------------------------------
LLM__PROVIDER=mock
LLM__MODEL=gpt-4o-mini
LLM__TEMPERATURE=0.2
LLM__MAX_TOKENS=1024

# Only needed if LLM__PROVIDER is set to the matching provider:
LLM__OPENAI_API_KEY=
LLM__ANTHROPIC_API_KEY=
LLM__GEMINI_API_KEY=
LLM__GROQ_API_KEY=

# ---------------------------------------------------------------------------
# RAG pipeline — local defaults, no external service required.
# ---------------------------------------------------------------------------
RAG__CHUNKING_STRATEGY=recursive
RAG__CHUNK_SIZE=800
RAG__CHUNK_OVERLAP=100
RAG__TOP_K=5
RAG__RERANKER=none

# ---------------------------------------------------------------------------
# Vector store — local (Chroma) by default. Pinecone is an OPTIONAL adapter.
# ---------------------------------------------------------------------------
VECTOR_STORE__PROVIDER=chroma
VECTOR_STORE__PERSIST_DIR=./data/chroma
VECTOR_STORE__PINECONE_API_KEY=
VECTOR_STORE__PINECONE_ENVIRONMENT=
VECTOR_STORE__PINECONE_INDEX=

# ---------------------------------------------------------------------------
# Neo4j (GraphRAG) — OPTIONAL. Disabled = in-memory graph fallback is used instead.
# ---------------------------------------------------------------------------
NEO4J__ENABLED=false
NEO4J__URI=bolt://localhost:7687
NEO4J__USER=neo4j
NEO4J__PASSWORD=

# ---------------------------------------------------------------------------
# Redis (memory/cache) — OPTIONAL. Disabled = in-memory fallback is used instead.
# ---------------------------------------------------------------------------
REDIS__ENABLED=false
REDIS__URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# RabbitMQ (async document pipeline) — OPTIONAL. Disabled = synchronous ingestion.
# ---------------------------------------------------------------------------
RABBITMQ__ENABLED=false
RABBITMQ__URL=amqp://guest:guest@localhost:5672/

# ---------------------------------------------------------------------------
# MCP server/client — local by default, no external dependency.
# ---------------------------------------------------------------------------
MCP__SERVER_HOST=127.0.0.1
MCP__SERVER_PORT=8765

# ---------------------------------------------------------------------------
# Voice — MOCK by default. ElevenLabs/Gemini are OPTIONAL adapters.
# ---------------------------------------------------------------------------
VOICE__PROVIDER=mock
VOICE__ELEVENLABS_API_KEY=
VOICE__GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# LangSmith — OPTIONAL, off by default.
# ---------------------------------------------------------------------------
LANGSMITH__ENABLED=false
LANGSMITH__API_KEY=
LANGSMITH__PROJECT=agentic-ai-platform

# ---------------------------------------------------------------------------
# Langfuse — OPTIONAL, off by default.
# ---------------------------------------------------------------------------
LANGFUSE__ENABLED=false
LANGFUSE__PUBLIC_KEY=
LANGFUSE__SECRET_KEY=
LANGFUSE__HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Evaluation — OPTIONAL, off by default.
# ---------------------------------------------------------------------------
EVALUATION__RAGAS_ENABLED=false
